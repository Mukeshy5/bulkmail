# Local public service listener. Keep this on loopback behind your HTTPS proxy.
PORT=3001

# Private API used by the desktop app. Do not expose this port publicly.
DESKTOP_API_PORT=3002

# Relative paths resolve from this backend folder.
BULK_MAIL_DB_PATH=data/bulk-mail-sender.sqlite

# Optional managed 32-byte base64 key. Leave blank to use the protected local key file.
# Back up this key securely and keep it unchanged when moving the database.
BULK_MAIL_CREDENTIAL_KEY=

# Optional HTTPS origin for public signup, confirmation, and unsubscribe links.
# Use an origin only, without a trailing slash.
PUBLIC_URL=

# Set to 1 only when a single trusted reverse proxy overwrites forwarding headers.
TRUST_PROXY=0

# Optional Cloudflare Turnstile configuration. Configure both keys and PUBLIC_URL together.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional provider webhook bearer secret (minimum 32 characters).
PROVIDER_WEBHOOK_SECRET=

# Optional Mailgun webhook signing key.
MAILGUN_WEBHOOK_SIGNING_KEY=

# Optional SMTP settings for double-opt-in confirmation messages.
# Configure host, user, password, and from together; port defaults to 587.
CONFIRM_SMTP_HOST=
CONFIRM_SMTP_PORT=587
CONFIRM_SMTP_USER=
CONFIRM_SMTP_PASSWORD=
CONFIRM_SMTP_FROM=
